{
  "version": "1.0.0",
  "description": "Risk-class manifest for PR readiness gating across the frankxai estate. A file may match multiple classes. Verdict is fail-closed: every changed file must match at least one class, and no gating class may be touched, for a 'clear' verdict.",
  "classes": {
    "executable_config": {
      "gating": true,
      "why": "Anything imported, executed, or read at runtime — including agent-governing documents and data files that drive behavior.",
      "paths": [
        "app/**", "components/**", "lib/**", "src/**", "scripts/**", "hooks/**",
        "data/**", "packages/**", "supabase/**", "api/**",
        ".github/**", ".claude/**", ".cursor/**", ".clinerules/**", ".gemini/**", ".grok/**",
        "CLAUDE.md", "AGENTS.md", "GROK.md", "**/CLAUDE.md", "**/AGENTS.md",
        "docs/ops/**", "**/*policy*", "**/*POLICY*", "**/skill-rules.json",
        "vercel.json", "Dockerfile", "Dockerfile.*", "docker-compose*",
        "*.config.js", "*.config.mjs", "*.config.ts", "next.config.*", "tailwind.config.*",
        "proxy.ts", "proxy.js", "middleware.ts", "middleware.js", "instrumentation.ts",
        "tsconfig*.json", ".eslintrc*", "eslint.config.*", "turbo.json", "pnpm-workspace.yaml"
      ],
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs", ".py", ".sh", ".ps1", ".psm1", ".rb", ".go", ".rs", ".sql", ".yml", ".yaml", ".toml", ".vbs"]
    },
    "generated_artifacts": {
      "gating": true,
      "why": "Regenerated by tooling, never edited by hand; a hand edit here is always wrong.",
      "paths": ["pnpm-lock.yaml", "package-lock.json", "yarn.lock", "bun.lockb", "Cargo.lock", "poetry.lock", "dist/**", "build/**", ".next/**", ".turbo/**", "**/*.min.js", "**/*.min.css"]
    },
    "public_claims": {
      "gating": true,
      "why": "Copy, metrics, and positioning that ship to readers; Metrics Truth Rule and integrity-guard apply before readiness.",
      "paths": ["content/**", "README.md", "book/**", "**/newsletters/**", "app/**/page.*", "app/**/layout.*", "public/**/*.html", "public/llms.txt"]
    },
    "asset_rights": {
      "gating": true,
      "why": "Media and fonts can carry licensing obligations; provenance must be verified by a human.",
      "paths": ["public/**", "assets/**"],
      "extensions": [".png", ".jpg", ".jpeg", ".webp", ".avif", ".gif", ".svg", ".ico", ".mp3", ".wav", ".mp4", ".mov", ".webm", ".woff", ".woff2", ".ttf", ".otf", ".pdf"]
    },
    "secrets": {
      "gating": true,
      "why": "Any credential-shaped content fails closed, wherever it appears.",
      "paths": [".env", ".env.*", "**/*credentials*", "**/*.pem", "**/*.key", "**/*.p12", "**/*.pfx"],
      "content_patterns": [
        "-----BEGIN [A-Z ]*PRIVATE KEY-----",
        "AKIA[0-9A-Z]{16}",
        "gh[pousr]_[A-Za-z0-9]{30,}",
        "sk-[A-Za-z0-9_-]{20,}",
        "xox[baprs]-[A-Za-z0-9-]{10,}",
        "(?i)\\b(api[_-]?key|client[_-]?secret|access[_-]?token|password)\\b\\s*[:=]\\s*[\"']?[A-Za-z0-9+/_-]{16,}[\"']?"
      ]
    },
    "dependencies": {
      "gating": true,
      "why": "Dependency changes alter the supply chain and need the repo's gates plus human review.",
      "paths": ["package.json", "**/package.json", "pnpm-lock.yaml", "package-lock.json", "yarn.lock", "requirements*.txt", "pyproject.toml", "go.mod", "go.sum", "Cargo.toml", "Gemfile", "composer.json"]
    },
    "migrations": {
      "gating": true,
      "why": "Schema and state changes can be irreversible; always human-decided.",
      "paths": ["**/migrations/**", "supabase/migrations/**", "prisma/migrations/**", "db/**/*.sql"]
    },
    "production_surfaces": {
      "gating": true,
      "why": "Files a deploy pipeline reads directly; changes here alter what production does.",
      "paths": ["vercel.json", ".vercelignore", "next.config.*", "wrangler.toml", "netlify.toml", "app/robots.*", "app/sitemap.*", "app/manifest.*", ".github/workflows/**"]
    },
    "prose_docs": {
      "gating": false,
      "why": "Plain prose documentation with no runtime, claims, or governing role. The only class that clears on its own.",
      "extensions": [".md", ".mdx", ".txt"]
    }
  }
}
