[0.006, "o", "Skills\u001b[8Gthat\u001b[13Gship\u001b[18Gwith\u001b[23Gtheir\u001b[29Gevals\u001b[35G(skills-with-evals)\r\r\n\u001b[3GDescription:\u001b[16GTen\u001b[20Gskills\u001b[27Gfrom\u001b[32Gthis\u001b[37Glibrary,\u001b[46Geach\u001b[51Gwith\u001b[56Gan\u001b[59Geval\u001b[64Gsuite\u001b[70Gin\u001b[73Gevals/<skill>/:\u001b[89Ga\u001b[91Gno-skill\u001b[100Gbaseline\r\r\narm,\u001b[6Ga\u001b[8Gtrigger\u001b[16Gtest,\u001b[22Gseeded-defect\u001b[36Grecall\u001b[43Gand\u001b[47Gclean-input\u001b[59Gprecision\u001b[69Gcases,\u001b[76Grun\u001b[80Gwith\u001b[85G`claude\u001b[93Gplugin\u001b[100Geval`.\r\r\nRelease\u001b[9Gcandidate;\u001b[20Gsee\u001b[24Gevals/<skill>/CARD.md.\r\r\n\u001b[3GSource:\u001b[11Gskills-with-evals@claude-skills-library\r\r\n\r\r\nComponent\u001b[11Ginventory\r\r\n\u001b[3GSkills\u001b[10G(10)\u001b[16Gai-architect-review,\u001b[37Gbook-publishing,\u001b[54Gexcellence-book-writing,\u001b[79Ggithub-code-review,\r\r\nlanggraph-patterns,\u001b[21Gmcp-architecture,\u001b[39Gnextjs-expert,\u001b[54Gproduct-management-expert,\u001b[81Gskill-builder,\r\r\nui-ux-design-expert\r\r\n\u001b[3GAgents\u001b[10G(0)\r\r\n\u001b[3GHooks\u001b[9G(0)\r\r\n\u001b[3GMCP\u001b[7Gservers\u001b[15G(0)\r\r\n\u001b[3GLSP\u001b[7Gservers\u001b[15G(0)\r\r\n\r\r\nProjected\u001b[11Gtoken\u001b[17Gcost\r\r\n\u001b[3GAlways-on:\u001b[16G~727\u001b[21Gtok\u001b[27Gadded\u001b[33Gto\u001b[36Gevery\u001b[42Gsession\r\r\n\r\r\nPer-component\u001b[15G(rounded)\r\r\n\u001b[3Gcomponent\u001b[30Galways-on\u001b[41Gon-invoke\r\r\n\u001b[3Gui-ux-design-expert\u001b[36G~80\u001b[45G~5.4k\r\r\n\u001b[3Ggithub-code-review\u001b[36G~60\u001b[45G~1.5k\r\r\n\u001b[3Gnextjs-expert\u001b[36G~70\u001b[45G~4.7k\r\r\n\u001b[3Gmcp-architecture\u001b[36G~70\u001b[45G~2.6k\r\r\n\u001b[3Gai-architect-review\u001b[35G~110\u001b[45G~2.7k\r\r\n\u001b[3Glanggraph-patterns\u001b[36G~70\u001b[45G~1.8k\r\r\n\u001b[3Gskill-builder\u001b[36G~80\u001b[45G~5.3k\r\r\n\u001b[3Gproduct-management-expert