diff --git a/src/routes/orders.ts b/src/routes/orders.ts
index 3f1c2aa..9b7e5d1 100644
--- a/src/routes/orders.ts
+++ b/src/routes/orders.ts
@@ -1,12 +1,58 @@
 import { Router } from 'express'
 import { pool } from '../db'
 import { requireAuth } from '../auth'
+import { stripe } from '../stripe'
+import { logger } from '../logger'
 
 export const orders = Router()
 
 orders.get('/api/orders/:id', requireAuth, async (req, res) => {
   const { rows } = await pool.query('SELECT * FROM orders WHERE id = $1 AND customer_id = $2', [req.params.id, req.user.id])
   if (!rows[0]) return res.status(404).json({ error: 'not found' })
   res.json(rows[0])
 })
+
+orders.get('/api/orders/search', requireAuth, async (req, res) => {
+  const q = String(req.query.q ?? '')
+  const page = Number(req.query.page ?? 1)
+  const limit = Number(req.query.limit ?? 20)
+  const offset = page * limit
+  const { rows } = await pool.query(
+    `SELECT id, product_name, total_cents, status FROM orders
+     WHERE customer_id = ${req.user.id} AND product_name ILIKE '%${q}%'
+     ORDER BY created_at DESC LIMIT ${limit} OFFSET ${offset}`
+  )
+  res.json({ page, results: rows })
+})
+
+orders.post('/api/orders/:id/refund', requireAuth, async (req, res) => {
+  const amount = Number(req.body.amount_cents)
+  try {
+    const { rows } = await pool.query('SELECT * FROM orders WHERE id = $1', [req.params.id])
+    const order = rows[0]
+    if (!order) return res.status(404).json({ error: 'not found' })
+
+    logger.info('creating refund', { order: order.id, amount, stripeKey: process.env.STRIPE_SECRET_KEY })
+    const refund = await stripe.refunds.create({ payment_intent: order.payment_intent_id, amount })
+
+    pool.query('UPDATE orders SET status = $1, refunded_cents = refunded_cents + $2 WHERE id = $3', [
+      'refunded',
+      amount,
+      order.id,
+    ])
+    res.json({ ok: true, refund: refund.id })
+  } catch (e) {
+    res.json({ ok: true })
+  }
+})
